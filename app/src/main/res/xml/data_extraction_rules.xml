<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Patient data is never uploaded to cloud backup. A direct
     device-to-device transfer (e.g. moving to a new phone) may copy it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="screenings" />
        <include domain="file" path="explanations" />
    </device-transfer>
</data-extraction-rules>
